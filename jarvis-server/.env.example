# Chave da API da OpenAI
OPENAI_API_KEY=sk-...

# Token de longa duração do Home Assistant
# Gere em: Perfil > Segurança > Tokens de acesso de longa duração
# (quando usar docker-compose, HA_URL é definido automaticamente como http://homeassistant:8123)
HA_TOKEN=seu_token_aqui

# Fuso horário do Home Assistant
TZ=America/Sao_Paulo

# Porta exposta do jarvis-server (apenas para execução local sem Docker)
PORT=3000
