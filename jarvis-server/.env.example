# Chave da API da OpenAI
OPENAI_API_KEY=sk-...

# URL base do Home Assistant (ex: http://192.168.1.100:8123)
HA_URL=http://SEU_IP_DO_HA:8123

# Token de longa duração do Home Assistant
# Gere em: Perfil > Segurança > Tokens de acesso de longa duração
HA_TOKEN=seu_token_aqui

# Porta do servidor (Render define automaticamente)
PORT=3000
